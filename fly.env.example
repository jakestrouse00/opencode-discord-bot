# opencode-discord-bot — Fly.io volume .env template.
#
# This file is NOT used directly. It's a template for the /data/.env that
# lives on the Fly volume. The bot reads .env from its cwd (/data, set by
# start.sh), and pydantic-settings merges .env values UNDER Fly secrets
# (env vars win over .env file values — see config.py:56).
#
# The split:
#   - Fly secrets (flyctl secrets set) = sensitive values that must never
#     be in a file on disk: DISCORD_BOT_TOKEN, OPENCODE_SERVER_PASSWORD,
#     COMULYTIC_JWT, TAILSCALE_AUTHKEY, API keys.
#   - /data/.env (this file, on the volume) = non-sensitive runtime config
#     that /oc_setup can write to at runtime: guild IDs, channel IDs,
#     category ID, voice settings, STT model size, etc.
#
# /oc_setup writes these fields to /data/.env at runtime (they MUST be in
# the .env file, NOT Fly secrets, because env vars shadow .env and
# /oc_setup's write would be silently ignored):
#   DISCORD_BOT_GUILD_ID
#   DISCORD_BOT_SESSION_CATEGORY_ID
#   DISCORD_BOT_ALLOWED_CHANNEL_IDS
#   VOICE_MESSAGE_TRIGGER_CHANNEL_ID
#
# To use: after the first `flyctl deploy`, copy this template to /data/.env
# on the Fly machine:
#   flyctl ssh console -C "cp /app/fly.env.example /data/.env"
# Then run /oc_setup in Discord, which will populate the guild-specific
# fields. Re-sync commands + restart after /oc_setup.

# === opencode serve lifecycle ( Fly secrets override these, but having
# them in .env documents the intent for anyone reading /data/.env) ===
OPENCODE_SERVE_ENABLED=false
OPENCODE_SERVER_URL=http://100.64.0.5:4097

# === Voice (local faster-whisper, CPU) ===
VOICE_STT_PROVIDER=local
VOICE_LOCAL_WHISPER_MODEL=small
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
VOICE_TTS_ENABLED=false

# === STT domain-word biasing (optional, all default empty = no bias) ===
# Space-separated domain words boosted by the faster-whisper CTranslate2
# decoder (local + auto paths only; the cloud OpenAI API has no equivalent).
# Purpose-built for rare / out-of-vocabulary words the model mishears
# (e.g. "comulytic" -> "Conulec" / "Kamilik"). Empty = no bias.
VOICE_STT_HOTWORDS=comulytic opencode pycord discord
# Short context sentence passed as decoder prefix context to BOTH the local
# path (faster-whisper `initial_prompt=`) and the cloud path (OpenAI
# `prompt=`). Best as a natural sentence containing the domain words.
# Empty = no prompt.
VOICE_STT_PROMPT=The user discusses Comulytic, opencode, Pycord, and Discord.
# JSON object mapping known mishearings to corrections, applied as a
# case-insensitive whole-word replace on the final transcript (both local
# and cloud paths). 100% reliable for enumerated mishearings; no inference
# cost. Malformed JSON = logged WARNING + no-op. Empty = no-op.
VOICE_STT_REPLACEMENTS={"Conulec":"comulytic","Kamilik":"comulytic","comulec":"comulytic","commu-lic":"comulytic","Commulec":"comulytic"}

# === Speaker ID (not installed in the Docker image) ===
SPEAKER_ID_ENABLED=false

# === Guild-specific fields (populated by /oc_setup — leave at defaults) ===
DISCORD_BOT_GUILD_ID=0
DISCORD_BOT_SESSION_CATEGORY_ID=0
DISCORD_BOT_ALLOWED_CHANNEL_IDS=[]
VOICE_MESSAGE_TRIGGER_CHANNEL_ID=1533242090862149842