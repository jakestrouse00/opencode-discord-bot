# opencode Discord control bot — environment variable template.
#
# Copy this file to `bot/.env` (or a `.env` in the directory you run the bot
# from) and fill in the values. All fields are optional except DISCORD_BOT_TOKEN
# (the bot exits with a clear message if it's empty). pydantic-settings reads
# this file automatically (env_file=".env"). Env vars set in the actual
# environment override these file values.
#
# Uppercase = the env var name (what pydantic-settings maps to the BotConfig
# field of the same name). See `bot/config.py` for the full field list + types.

# === Discord (REQUIRED) ===
# Get this at https://discord.com/developers/applications (Bot tab).
# Empty = bot disabled (bot/__main__.py exits 1 with a clear message).
DISCORD_BOT_TOKEN=

# The guild (server) to sync slash commands to. 0 = global sync (slower, takes
# up to 1 hour to propagate; guild sync is instant). Find via Developer Mode ->
# right-click your server -> Copy ID.
DISCORD_BOT_GUILD_ID=0

# Restrict slash commands to specific channels (JSON list). Empty = all
# channels allowed (for testing/personal use). Bot-created session channels
# are always allowed regardless of this list.
# DISCORD_BOT_ALLOWED_CHANNEL_IDS=[123456789,987654321]

# The Discord category (folder) under which /oc and /oc_plan create a fresh
# text channel per invocation. 0/unset = create channels with no parent
# category.
DISCORD_BOT_SESSION_CATEGORY_ID=0

# === opencode serve lifecycle ===
# The bot auto-spawns `opencode serve` as a child process on login (unless
# OPENCODE_SERVE_ENABLED=false). These settings control that subprocess.
# The client (OpencodeClient) reads OPENCODE_SERVER_URL; the spawned server
# reads OPENCODE_SERVE_PORT + OPENCODE_SERVE_HOSTNAME. Keep these in sync —
# changing the port without updating the URL makes the client hit a dead
# port while the server listens elsewhere.
#
# IMPORTANT: if `opencode-remote-gui` is running, it owns port 4096 (its
# Flet UI). The bot must use 4097 (the real `opencode serve` port) —
# pointing at 4096 makes the bot's health probe false-positive on the GUI's
# HTML and every API call 405s. If your `.env` pins 4096, update it to 4097.
OPENCODE_SERVER_URL=http://127.0.0.1:4097
# REQUIRED for the server to accept requests — `opencode serve` returns 401 on
# every endpoint if this is empty. The bot seeds it into the subprocess env and
# sends it as basic auth on every request.
OPENCODE_SERVER_PASSWORD=opencode-local-dev
# Basic-auth username. The server always expects "opencode"; exposed for
# completeness and to keep the client + .env in sync rather than hardcoding a
# magic string.
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVE_ENABLED=true
OPENCODE_SERVE_PORT=4097
OPENCODE_SERVE_HOSTNAME=127.0.0.1
# JSON list, e.g. '["http://localhost:5173"]'
# OPENCODE_SERVE_CORS=[]
OPENCODE_SERVE_STARTUP_TIMEOUT=30.0
# Absolute path to the project directory `opencode serve` should run in.
# Empty = use the bot's launch directory (Path.cwd()). Set this when your
# .env lives in a subdirectory but your .opencode/ (plans, agents, config)
# lives at the project root — otherwise sessions resolve their project dir
# to the subdirectory and can't find your plans/agents.
# Example: OPENCODE_SERVE_CWD=C:\Users\jakes\PycharmProjects\multiAgent
OPENCODE_SERVE_CWD=

# === Singleton lock (single-instance enforcement) ===
# Absolute path to the OS file lock that prevents a second bot process from
# racing the Discord gateway (Discord allows one gateway session per token).
# Empty = `.opencode-discord-bot.lock` in the launch cwd. Override for
# non-standard launch dirs.
OC_SINGLETON_LOCK=

# === Model overrides (optional) ===
# When non-empty, the bot sends this model id in every prompt body, overriding
# the per-agent `model:` frontmatter field on the opencode server side. Empty =
# each opencode agent's own frontmatter model wins (the default). Two separate
# fields so the default agent and the oc-assistant (Bobby) agent can target different
# models independently. Model ids are provider-scoped — e.g.
# `ollama-cloud/glm-5.2`, `anthropic/claude-sonnet-4`, `openai/gpt-5`. See the
# opencode server docs for the accepted format on your provider.
#
# OPENCODE_DEFAULT_MODEL covers /oc and plain-text follow-ups (agent=None).
# OPENCODE_ASSISTANT_MODEL covers /oc_plan, /oc_voice, /oc_talk, voice-message
# trigger-channel sessions, and the Comulytic bridge (all agent="oc-assistant").
OPENCODE_DEFAULT_MODEL=
OPENCODE_ASSISTANT_MODEL=

# === Voice (STT + TTS) — optional, /oc_voice and /oc_talk commands ===
# Voice messages (press-hold mic in the mobile composer) are detected in
# on_message and routed through the same transcription pipeline as /oc_talk.
# VOICE_MESSAGE_ENABLED gates the feature; set false to disable it without
# affecting /oc_talk or /oc_voice.
VOICE_MESSAGE_ENABLED=true
# The channel id where a voice message starts a NEW oc-assistant (Bobby) session.
# Voice messages in existing session channels still work as follow-ups
# regardless of this value. 0 = disable the new-session path (only follow-ups
# work). Defaults to #new-plans (1533242090862149842).
VOICE_MESSAGE_TRIGGER_CHANNEL_ID=1533242090862149842
# Seconds of continuous silence before the voice session auto-finalizes.
VOICE_SILENCE_TIMEOUT_SECONDS=10.0
# Recording chunk duration (seconds) before the stop-restart-transcribe cycle.
VOICE_CHUNK_SECONDS=5.0
# STT provider: "local" = faster-whisper (CTranslate2, default, no cloud API);
# "openai" = cloud Whisper API (needs OPENAI_API_KEY); "auto" = try local
# first, fall back to cloud on any error.
VOICE_STT_PROVIDER=local
# Cloud Whisper model name (applies only when VOICE_STT_PROVIDER is "openai" or
# the "auto" fallback to cloud).
VOICE_STT_MODEL=whisper-1
# Local faster-whisper model size (applies only when VOICE_STT_PROVIDER is
# "local" or "auto" local path). One of tiny/base/small/medium/large.
VOICE_LOCAL_WHISPER_MODEL=medium
# TTS (response playback): when true, the bot synthesizes the final assistant
# text via OpenAI TTS and plays it in the voice channel. Requires ffmpeg on
# PATH (system binary, not pip).
VOICE_TTS_ENABLED=true
VOICE_TTS_MODEL=tts-1
VOICE_TTS_VOICE=alloy
VOICE_TTS_SPEED=1.0

# === faster-whisper (local STT, CTranslate2 backend) ===
# faster-whisper model name (applies only when VOICE_STT_PROVIDER is "local" or
# the "auto" local path). One of tiny/base/small/medium/large (or a
# CTranslate2-compatible path). `base` (~140MB) is CPU-feasible; `medium`/`large`
# benefit most from a GPU.
WHISPER_MODEL=medium
# "cpu" or "cuda" — faster-whisper device. "cuda" runs on an NVIDIA GPU
# (needs faster-whisper + a CUDA-enabled CTranslate2 build). Set to "cpu" if
# no GPU is available.
WHISPER_DEVICE=cpu
# CTranslate2 compute type. Pair with the device:
#   - WHISPER_DEVICE=cpu  -> "int8" (the CPU default)
#   - WHISPER_DEVICE=cuda -> "float16" (fastest, full GPU) or "int8_float16"
#     (lower VRAM, slightly slower; good for mid-range GPUs)
WHISPER_COMPUTE_TYPE=int8

# === Speaker identification (diarization, optional) ===
# Adds per-speaker labels to multi-speaker recordings (meetings, not just
# solo notes) so oc-assistant (Bobby) can produce coherent meeting notes. Layered
# on top of the existing anonymous STT path; requires the optional
# `speakers` extra + a `Speakers/<name>/` folder of reference audio.
# Degrades gracefully to the anonymous single-string transcript when the
# extra isn't installed, `SPEAKER_ID_ENABLED=false`, or the `Speakers/`
# folder is absent/empty — no error, the bot just produces an anonymous
# transcript as before.
#
# Install the optional heavy dep (pyannote.audio + torch, ~1-2GB):
#   pip install 'opencode-discord-bot[speakers]'
# (pyannote.audio 3.x downloads pretrained models from HuggingFace on
# first use — accept the model licenses + set HF_TOKEN before first run.)
SPEAKERS_DIR=Speakers
SPEAKER_ID_ENABLED=true
# Cosine-similarity cutoff for matching a turn's embedding to a known
# speaker's reference embeddings. A turn is attributed to the known
# speaker with the max cosine similarity ONLY if that max exceeds this
# threshold; otherwise the turn gets a generic `Speaker N` label.
SPEAKER_MATCH_THRESHOLD=0.75
# HuggingFace access token for pyannote.audio model downloads
# (speaker-diarization-3.1 + segmentation-3.0 + wespeaker-voxceleb-
# resnet34-LM + speaker-diarization-community-1 are gated). Empty =
# speaker ID 401s on first model load + falls back to anonymous STT.
# Get one at https://huggingface.co/settings/tokens (read scope) AFTER
# accepting the licenses at all four model pages:
#   https://huggingface.co/pyannote/speaker-diarization-3.1
#   https://huggingface.co/pyannote/segmentation-3.0
#   https://huggingface.co/pyannote/wespeaker-voxceleb-resnet34-LM
#   https://huggingface.co/pyannote/speaker-diarization-community-1
HF_TOKEN=

# === OpenAI (TTS only — also used for cloud STT fallback) ===
# Needed for TTS (VOICE_TTS_ENABLED=true) and for the cloud STT path
# (VOICE_STT_PROVIDER=openai or auto). Empty = those features raise a clear
# error at call time; the bot still starts. NOT needed for local STT
# (VOICE_STT_PROVIDER=local uses faster-whisper, no OpenAI key required).
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# === Slug LLM (channel-name generation) — optional ===
# The bot generates Discord channel-name slugs via one LLM call to an
# OpenAI-compatible /chat/completions endpoint (Ollama Cloud by default). If
# OLLAMA_AUTH_KEY is empty, slugs silently fall back to a regex-only generator
# (no LLM call) — the bot still works, just with less clever channel names.
# Get an Ollama Cloud key at https://ollama.com (or point OLLAMA_API_URL at any
# OpenAI-compatible endpoint with a matching key).
OLLAMA_API_URL=https://ollama.com/v1
OLLAMA_AUTH_KEY=
SLUG_MODEL=gpt-oss:20b-cloud
SLUG_TIMEOUT_SECONDS=8.0

# === Comulytic cloud bridge (optional, polling-based) ===
# Routes Comulytic Note Pro recordings to opencode's oc-assistant (Bobby) agent.
# Disabled by default — set COMULYTIC_ENABLED=true to activate. Requires a
# captured JWT (see SETUP_GUIDE.md "Comulytic bridge" section).
# COMULYTIC_ENABLED=true
# COMULYTIC_JWT=<capture from a login at web.comulytic.ai — 150-day TTL>
# COMULYTIC_REFRESH_TOKEN=<capture alongside the access JWT — 365-day TTL; refresh *call* is a gap>
# COMULYTIC_API_BASE=https://api.comulytic.ai
# COMULYTIC_WEB_BASE=https://web.comulytic.ai
# COMULYTIC_AUDIO_PATH=proxy  # "proxy" (Path B, recommended) | "presigned" (Path A)
# COMULYTIC_POLL_INTERVAL_SECONDS=60
# COMULYTIC_POLL_PAGE_SIZE=20
# COMULYTIC_USER_AGENT=  # empty = bridge derives a stable desktop Chrome UA
# COMULYTIC_PLAN_TYPE=  # "" (let oc-assistant (Bobby) classify) | "actionable" | "note"
# COMULYTIC_RELOGIN_WARN_DAYS=1
# COMULYTIC_STATE_FILE=.comulytic-seen.json
#
# --- Comulytic bridge -> Discord channel (mirrors /oc_talk) ---
# When DISCORD_BOT_TOKEN + DISCORD_BOT_GUILD_ID are set, the bridge creates a
# Discord text channel for each routed recording, posts the transcript, fires
# an LLM slug rename, surfaces oc-assistant (Bobby) clarifying questions as plain-text
# prompts in the channel, and posts the final response. Uses raw Discord REST
# (no Pycord, no gateway — safe to run alongside the main bot). When Discord
# isn't configured, the bridge routes to oc-assistant (Bobby) and LOGs the response.
# COMULYTIC_DISCORD_POINTER_CHANNEL_ID=0  # 0 = no pointer; else a channel id to post "Created #channel" in
# COMULYTIC_QUESTION_TIMEOUT_SECONDS=300  # how long to wait for the user's plain-text reply to a question
# COMULYTIC_QUESTION_POLL_INTERVAL_SECONDS=2.0  # poll cadence for GET /question + /permission
# --- Max-recording-duration cap (guards against accidental long recordings) ---
# Recordings longer than HOURS+MINUTES+SECONDS are marked as seen but NOT
# transcribed (skips both WAV conversion and the expensive local Whisper STT
# pass). The audio is still downloaded so its duration can be probed via
# ffprobe; if the probe fails the recording is transcribed as before. Set all
# three to 0 to disable the cap entirely. Default 1h0m0s = 3600s.
# COMULYTIC_MAX_DURATION_HOURS=1
# COMULYTIC_MAX_DURATION_MINUTES=0
# COMULYTIC_MAX_DURATION_SECONDS=0